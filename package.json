{
  "name": "xenon",
  "displayName": "Xenon",
  "description": "Xenon Language support for VSCode.",
  "version": "0.1.0",
  "publisher": "Tired Siren",
  "license": "MIT",
  "icon": "resources/xenon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZemMezzer/xenon.vscode.git"
  },
  "bugs": {
    "url": "https://github.com/ZemMezzer/xenon.vscode/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "xenon",
    "language",
    "lsp",
    "compiler"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.xe",
    "workspaceContains:**/*.xeproj",
    "workspaceContains:**/*.xws"
  ],
  "contributes": {
    "languages": [
      {
        "id": "xenon",
        "aliases": [
          "Xenon",
          "xenon"
        ],
        "extensions": [
          ".xe"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./resources/xenon.png",
          "dark": "./resources/xenon.png"
        }
      },
      {
        "id": "xenon-project",
        "aliases": [
          "Xenon Project"
        ],
        "extensions": [
          ".xeproj"
        ],
        "icon": {
          "light": "./resources/xenon.png",
          "dark": "./resources/xenon.png"
        }
      },
      {
        "id": "xenon-workspace",
        "aliases": [
          "Xenon Workspace"
        ],
        "extensions": [
          ".xws"
        ],
        "icon": {
          "light": "./resources/xenon.png",
          "dark": "./resources/xenon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "xenon",
        "scopeName": "source.xenon",
        "path": "./syntaxes/xenon.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Xenon",
      "properties": {
        "xenon.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute path to the Xenon executable. Leave empty to use 'xenon' from PATH."
        }
      }
    },
    "commands": [
      {
        "command": "xenon.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Xenon"
      },
      {
        "command": "xenon.showLanguageServerOutput",
        "title": "Show Language Server Output",
        "category": "Xenon"
      }
    ]
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && node ./esbuild.mjs",
    "watch": "node ./esbuild.mjs --watch",
    "test:unit": "tsx --test test/unit/*.test.ts",
    "compile-tests": "tsc -p ./test/tsconfig.json",
    "test:integration": "npm run compile && npm run compile-tests && node ./dist-test/runDevelopmentTest.js",
    "test:installed": "npm run package && npm run compile-tests && node ./dist-test/runInstalledTest.js",
    "test": "npm run test:unit && npm run compile",
    "package": "npm run clean && npm run test && vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
