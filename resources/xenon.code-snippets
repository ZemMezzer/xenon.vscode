{
  "Inferred local variable": {
    "prefix": "var",
    "body": "var ${1:name} = ${2:expression};$0",
    "description": "Local variable whose type is inferred from its required initializer"
  },
  "Readonly inferred local variable": {
    "prefix": "readonly var",
    "body": "readonly var ${1:name} = ${2:expression};$0",
    "description": "Readonly local variable with an inferred type"
  },
  "Arrow lambda": {
    "prefix": "lambda",
    "body": [
      "[](${1:int value}) => {",
      "\t${0:return value;}",
      "}"
    ],
    "description": "Non-capturing arrow lambda"
  },
  "Function value": {
    "prefix": "functionvalue",
    "body": [
      "function ${1:int}(${2:int}) ${3:callback} = [](${2} ${4:value}) => {",
      "\t${0:return value;}",
      "};"
    ],
    "description": "First-class Xenon function value"
  },
  "Value capture lambda": {
    "prefix": "lambdacapture",
    "body": [
      "[${1:value}](${2:int input}) => {",
      "\t${0:return value + input;}",
      "}"
    ]
  },
  "Move capture lambda": {
    "prefix": "lambdamove",
    "body": [
      "[move ${1:value}]() => {",
      "\t${0:value->Use();}",
      "}"
    ]
  },
  "Mutable borrow capture lambda": {
    "prefix": "lambdaborrow",
    "body": [
      "[&${1:value}](${2:int input}) => {",
      "\t${0:value += input;}",
      "}"
    ]
  },
  "Readonly borrow capture lambda": {
    "prefix": "lambdareadonly",
    "body": [
      "[readonly &${1:value}](${2:int input}) => {",
      "\t${0:return value + input;}",
      "}"
    ]
  },
  "Raw function pointer lambda": {
    "prefix": "lambdaraw",
    "body": [
      "function ${1:int}(${2:int})* ${3:callback} = [](${2} ${4:value}) => {",
      "\t${0:return value;}",
      "};"
    ],
    "description": "Capture-free lambda stored as a raw function pointer"
  },
  "Await value": {
    "prefix": "await",
    "body": "${1:Result} ${2:value} = await ${3:operation};",
    "description": "Await a library operation inside an async function"
  },
  "Await operator": {
    "prefix": "opawait",
    "body": [
      "public static bool operator await(readonly ${1:Operation}& value, storage<${2:Result}>& result, function void() continuation)",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Value await protocol: true initializes storage; false retains the continuation"
  },
  "Resolve operator": {
    "prefix": "opresolve",
    "body": [
      "public static void operator resolve(${1:Task}& target, ${2:Result} value)",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Successful terminal completion operator"
  },
  "Reject operator": {
    "prefix": "opreject",
    "body": [
      "public static void operator reject(${1:Task}& target, ${2:Error} error)",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Exceptional terminal completion operator"
  },
  "Async function": {
    "prefix": "async",
    "body": [
      "async ${1:Result} ${2:Name}(${3})",
      "{",
      "    $0",
      "}"
    ],
    "description": "Function using resolve/reject completion semantics; await is optional"
  }
}
