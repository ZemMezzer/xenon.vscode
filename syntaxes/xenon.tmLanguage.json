{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Xenon",
  "scopeName": "source.xenon",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#language-constants"
    },
    {
      "include": "#contextual-identifiers"
    },
    {
      "include": "#generic-types"
    },
    {
      "include": "#types"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#control-keywords"
    },
    {
      "include": "#declaration-keywords"
    },
    {
      "include": "#value-keywords"
    },
    {
      "include": "#ownership-keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.xenon",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.xenon",
          "begin": "//",
          "end": "$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.xenon",
      "begin": "\"",
      "end": "\"|(?=$)",
      "patterns": [
        {
          "name": "constant.character.escape.xenon",
          "match": "\\\\[0nrt\"\\\\]"
        },
        {
          "name": "invalid.illegal.escape.xenon",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.hexadecimal.xenon",
          "match": "\\b0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.integer.binary.xenon",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.float.xenon",
          "match": "\\b(?:[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?[fF]?|[0-9]+[eE][+-]?[0-9]+[fF]?|[0-9]+[fF])\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.xenon",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "language-constants": {
      "name": "constant.language.xenon",
      "match": "\\b(?:true|false|null)\\b"
    },
    "contextual-identifiers": {
      "patterns": [
        {
          "name": "storage.modifier.xenon",
          "match": "\\bthis\\b"
        },
        {
          "name": "meta.accessor.setter.xenon",
          "begin": "\\b(set)\\b\\s*(\\{)",
          "beginCaptures": {
            "1": {
              "name": "storage.modifier.xenon"
            },
            "2": {
              "name": "punctuation.section.group.begin.xenon"
            }
          },
          "end": "(\\})",
          "endCaptures": {
            "1": {
              "name": "punctuation.section.group.end.xenon"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "name": "storage.modifier.xenon",
              "match": "\\bvalue\\b"
            },
            {
              "include": "#setter-braces"
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "setter-braces": {
      "name": "meta.block.setter.xenon",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "name": "storage.modifier.xenon",
          "match": "\\bvalue\\b"
        },
        {
          "include": "#setter-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "generic-types": {
      "name": "entity.name.type.struct.xenon",
      "match": "\\b[A-Z][A-Za-z0-9_]*(?=\\s*<)"
    },
    "types": {
      "name": "storage.type.primitive.xenon",
      "match": "\\b(?:void|bool|byte|sbyte|short|ushort|int|uint|long|ulong|float|double|nint|nuint|clong|culong)\\b"
    },
    "modifiers": {
      "name": "storage.modifier.xenon",
      "match": "\\b(?:const|readonly|static|virtual|override|abstract|extern|export|public|private)\\b"
    },
    "control-keywords": {
      "name": "keyword.control.xenon",
      "match": "\\b(?:switch|case|default|if|else|while|for|break|continue|return)\\b"
    },
    "declaration-keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.xenon",
          "match": "\\busing\\b"
        },
        {
          "name": "keyword.declaration.xenon",
          "match": "\\b(?:namespace|struct|interface|template|enum)\\b"
        },
        {
          "name": "keyword.declaration.constraint.xenon",
          "match": "\\bwhere\\b"
        }
      ]
    },
    "value-keywords": {
      "name": "storage.modifier.xenon",
      "match": "\\b(?:new|free|this|base|get|set|sizeof|alignof|offsetof|cast|bitcast)\\b"
    },
    "ownership-keywords": {
      "patterns": [
        {
          "name": "storage.modifier.xenon",
          "match": "\\bmove\\b"
        },
        {
          "name": "storage.modifier.xenon",
          "match": "\\b(?:unique|shared|weak)(?=\\s*<)"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.xenon",
      "match": "(?:<<=|>>=|->|\\+\\+|--|==|!=|<=|>=|&&|\\|\\||<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|[+\\-*/%=!<>&|^~])"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.xenon",
          "match": ";"
        },
        {
          "name": "punctuation.separator.xenon",
          "match": "[,.:]"
        },
        {
          "name": "punctuation.section.group.xenon",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}
